+
+
+def apply_coupon(total: Decimal, code: str) -> Decimal:
+    """Apply SAVE10 to a finite, nonnegative total and round to cents.
+
+    Example: apply_coupon(Decimal("10.00"), "SAVE10") -> Decimal("9.00")
+    """
+    if code != "SAVE10":
+        raise AppError("INVALID_COUPON", "Coupon code is invalid.")
+    if not isinstance(total, Decimal) or not total.is_finite() or total < 0:
+        raise AppError("INVALID_TOTAL", "Total must be a finite, nonnegative Decimal.")
+    try:
+        return (total * Decimal("0.90")).quantize(
+            Decimal("0.01"), rounding=ROUND_HALF_UP
+        )
+    except InvalidOperation as exc:
+        raise AppError("INVALID_TOTAL", "Total cannot be rounded to cents.") from exc
