+class ApplyCouponTests(unittest.TestCase):
+    def test_save10_discounts_and_rounds_to_cents(self):
+        for total, expected in [("100.00", "90.00"), ("0", "0.00"),
+                                ("0.05", "0.05"), ("1.01", "0.91")]:
+            with self.subTest(total=total):
+                result = apply_coupon(Decimal(total), "SAVE10")
+                self.assertIsInstance(result, Decimal)
+                self.assertEqual(result, Decimal(expected))
+                self.assertEqual(result.as_tuple().exponent, -2)
+
+    def test_rejects_other_codes(self):
+        for code in ("SAVE20", "save10", "", " SAVE10", None, 10):
+            with self.subTest(code=code):
+                with self.assertRaises(AppError) as raised:
+                    apply_coupon(Decimal("10.00"), code)
+                self.assertEqual(raised.exception.code, "INVALID_COUPON")
+
+    def test_rejects_invalid_totals(self):
+        for total in (None, "10.00", 10, Decimal("-1"), Decimal("NaN"),
+                      Decimal("sNaN"), Decimal("Infinity"), Decimal("-Infinity"),
+                      Decimal("1E+100")):
+            with self.subTest(total=total):
+                with self.assertRaises(AppError) as raised:
+                    apply_coupon(total, "SAVE10")
+                self.assertEqual(raised.exception.code, "INVALID_TOTAL")
+
+
 if __name__ == "__main__":
     unittest.main()
